{
  "name": "minecraft-server-panel-server",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "init": "bun server.ts init --development",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit",
    "build": "bun build.ts",
    "smoke:compiled": "bun tests/compiled-smoke.ts",
    "benchmark:archive": "bun benchmarks/archive.bench.ts",
    "benchmark:database": "bun benchmarks/database.bench.ts",
    "benchmark:runtime-comparison": "bun benchmarks/runtime-comparison.bench.ts"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.3",
    "@socket.io/bun-engine": "0.1.2",
    "@zip.js/zip.js": "2.23.0",
    "jose": "6.2.12",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2"
  }
}
