ROOT_USERNAME=admin
# Bun expands '$' in .env values, including quoted values. Escape each bcrypt '$' as '\$'.
ROOT_PASSWORD_HASH=\$2b\$10\$replace_with_an_existing_bcrypt_hash
JWT_SECRET=replace-with-at-least-32-random-characters
PANEL_HOST=127.0.0.1
PORT=3001
SECURE_STATUS=false
ALLOW_INSECURE_HTTP=false
PANEL_DEPLOYMENT_MODE=test
PANEL_PUBLIC_ADDRESS=127.0.0.1
NODE_ENV=test
PANEL_DATA_DIR=./panel-data
UPLOAD_MAX_BYTES=2147483648

# Optional compatibility setting for a genuinely cross-origin frontend.
# Same-origin Vite/Caddy deployments do not need it.
# CORSORIGIN=http://localhost:5173
